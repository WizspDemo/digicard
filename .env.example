# Postgres connection string (Coolify provides this if you add a Postgres resource)
DATABASE_URL="postgresql://user:***@host:5432/digicard"

# Bootstrap admin — created on first boot if no ADMIN user exists yet.
# Safe to leave set permanently; it no-ops once an admin exists.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Random long string used to sign session cookies
SESSION_SECRET="change-me-too-long-random-string"
